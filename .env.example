BIND_ADDR=0.0.0.0:8080
MMDB_PATH=data/dbip.mmdb
# Empty means trust only the TCP peer. Configure ONLY verified ingress networks.
TRUSTED_PROXY_CIDRS=
# x-forwarded-for: walk right-to-left; other headers MUST be overwritten by ingress.
CLIENT_IP_HEADER=x-forwarded-for
GA4_MEASUREMENT_ID=
# Enable only after production domain, privacy and ingress checks in docs/operations.html.
SITE_INDEXABLE=false


# Optional authenticated CDN ingress. Keep secret; Bunny overwrites both ingress headers.
INGRESS_SECRET=
