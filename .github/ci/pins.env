# Pinned tool versions and the slow-test rule that ci.yml,
# .github/ciod/prefetch.sh, .github/ci/parts.sh and .github/ci/timing.py read.
# scripts/render_readme.py's only dependency; SHA-256 of the PyPI wheel.
MARKDOWN_VERSION=3.11.2
MARKDOWN_SHA256=f80390747a2a0ff2ba54da074ce4f862f72a6685f608cd2637b646a6d83993f5
# Tests marked slow (README.md, Development): pull requests skip them, and
# only they may take over 60 s there. A Rust test whose name matches this
# regex (it, or a :: segment of it, starts with slow_); a Playwright tag.
SLOW_RUST_FILTER='^slow_|::slow_'
SLOW_BROWSER_TAG=@slow
