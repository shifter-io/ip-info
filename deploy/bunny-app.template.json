{
  "name": "ip-info",
  "runtimeType": "shared",
  "terminationGracePeriodSeconds": 15,
  "repositorySettings": {
    "repositoryName": "ip-info",
    "owner": "YOUR_GITHUB_OWNER"
  },
  "autoScaling": {
    "min": 1,
    "max": 1
  },
  "regionSettings": {
    "allowedRegionIds": [
      "AMS",
      "ASB",
      "AT",
      "BO",
      "BR",
      "BU",
      "CA",
      "CO",
      "CZ",
      "DE",
      "DEN",
      "DK",
      "ES",
      "FR",
      "GA",
      "GR",
      "HK",
      "HR",
      "IL",
      "ISR",
      "IT",
      "JH",
      "JP",
      "LA",
      "MI",
      "MX",
      "NY",
      "PL",
      "SE",
      "SG",
      "SIL",
      "SYD",
      "TR",
      "TX",
      "UA",
      "UK",
      "WA"
    ],
    "requiredRegionIds": [
      "AMS",
      "ASB",
      "AT",
      "BO",
      "BR",
      "BU",
      "CA",
      "CO",
      "CZ",
      "DE",
      "DEN",
      "DK",
      "ES",
      "FR",
      "GA",
      "GR",
      "HK",
      "HR",
      "IL",
      "ISR",
      "IT",
      "JH",
      "JP",
      "LA",
      "MI",
      "MX",
      "NY",
      "PL",
      "SE",
      "SG",
      "SIL",
      "SYD",
      "TR",
      "TX",
      "UA",
      "UK",
      "WA"
    ],
    "maxAllowedRegions": 37
  },
  "containerTemplates": [
    {
      "name": "ip-info",
      "imageName": "ip-info",
      "imageNamespace": "YOUR_GITHUB_OWNER",
      "imageTag": "YOUR_IMAGE_TAG",
      "imageRegistryId": "YOUR_BUNNY_REGISTRY_ID",
      "imagePullPolicy": "always",
      "environmentVariables": [
        {
          "name": "BIND_ADDR",
          "value": "0.0.0.0:8080"
        },
        {
          "name": "MMDB_PATH",
          "value": "/data/dbip.mmdb"
        },
        {
          "name": "SITE_INDEXABLE",
          "value": "false"
        },
        {
          "name": "GA4_MEASUREMENT_ID",
          "value": ""
        }
      ],
      "probes": {
        "startup": {
          "initialDelaySeconds": 5,
          "periodSeconds": 10,
          "timeoutSeconds": 5,
          "failureThreshold": 12,
          "successThreshold": 1,
          "httpGet": {
            "request": {
              "path": "/readyz",
              "portNumber": 8080
            },
            "response": {
              "expectedStatusCode": 200
            }
          }
        },
        "readiness": {
          "initialDelaySeconds": 5,
          "periodSeconds": 10,
          "timeoutSeconds": 5,
          "failureThreshold": 3,
          "successThreshold": 1,
          "httpGet": {
            "request": {
              "path": "/readyz",
              "portNumber": 8080
            },
            "response": {
              "expectedStatusCode": 200
            }
          }
        },
        "liveness": {
          "initialDelaySeconds": 5,
          "periodSeconds": 10,
          "timeoutSeconds": 5,
          "failureThreshold": 3,
          "successThreshold": 1,
          "httpGet": {
            "request": {
              "path": "/healthz",
              "portNumber": 8080
            },
            "response": {
              "expectedStatusCode": 200
            }
          }
        }
      },
      "endpoints": [
        {
          "displayName": "Web",
          "cdn": {
            "isSslEnabled": false,
            "portMappings": [
              {
                "containerPort": 8080
              }
            ]
          }
        },
        {
          "displayName": "Anycast",
          "anycast": {
            "type": "iPv4",
            "portMappings": [
              {
                "containerPort": 8080,
                "exposedPort": 80,
                "protocols": [
                  "tcp"
                ]
              }
            ]
          }
        }
      ],
      "imageDigest": "YOUR_IMAGE_DIGEST"
    }
  ]
}
